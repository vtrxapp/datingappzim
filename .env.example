# ---------------------------------------------------------------------------
# Copy to .env (root) and/or apps/api/.env for local development.
# Nothing in this file is a real secret.
# ---------------------------------------------------------------------------

# --- Postgres --------------------------------------------------------------
DATABASE_URL="postgresql://tariro:tariro@localhost:5432/tariro?schema=public"

# --- Redis -------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT --------------------------------------------------------------
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- OTP -----------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMS provider (see apps/api/src/notifications) --------------------------
# "mock" logs OTP codes to the API console instead of sending a real SMS.
SMS_PROVIDER=mock

# --- Storage / media (Cloudflare R2, S3-compatible) --------------------------
# "local" writes to apps/api/.local-storage and serves it back for dev.
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tariro-media
R2_PUBLIC_BASE_URL=

# --- Payments (EcoCash via Paynow) -------------------------------------------
# "mock" simulates a successful payment after a short delay for local dev.
PAYMENT_PROVIDER=mock
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RETURN_URL=http://localhost:3000/settings/premium/return
PAYNOW_RESULT_URL=http://localhost:4000/subscriptions/payments/webhook

# --- App -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Admin bootstrap (dev only) ---------------------------------------------
# Phone number that is automatically granted the ADMIN role on first OTP verify.
ADMIN_BOOTSTRAP_PHONE=
